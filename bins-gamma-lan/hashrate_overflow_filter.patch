diff --git a/main/tasks/hashrate_monitor_task.cpp b/main/tasks/hashrate_monitor_task.cpp
index 738596c..e94012b 100644
--- a/main/tasks/hashrate_monitor_task.cpp
+++ b/main/tasks/hashrate_monitor_task.cpp
@@ -141,6 +141,13 @@ void HashrateMonitor::onRegisterReply(uint8_t asic_idx, uint32_t counterNow)
     int64_t timeDelta = now - m_prevResponse[asic_idx];
     uint32_t counterDelta = counterNow - m_prevCounter[asic_idx];
 
+    // Filter out 32-bit counter underflow / corrupt packet anomalies (e.g. 28M GH/s spikes)
+    if (counterNow < m_prevCounter[asic_idx] || counterDelta >= 4096) {
+        m_prevCounter[asic_idx] = counterNow;
+        m_prevResponse[asic_idx] = now;
+        return;
+    }
+
     double chip_ghs = (double) counterDelta * (double) 0x100000000uLL / (double) timeDelta / 1000.0;
 
     setChipHashrate(asic_idx, chip_ghs);
