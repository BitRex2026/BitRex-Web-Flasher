+}
+
+int BM1387::countChipsUsb()
+{
+    uint8_t cmd[5] = {0x54, 0x05, 0x00, 0x00, 0x00};
+    bm1387_frame_cmd(cmd, sizeof(cmd));
+
+    FTDI_USB_purge();
+    FTDI_USB_write(cmd, sizeof(cmd), 200);
+
+    int found = 0;
+    int64_t end_us = esp_timer_get_time() + 500000; // 500 ms
+    uint8_t rec[BM1387_RX_LEN];
+    while (esp_timer_get_time() < end_us) {
+        int got = FTDI_USB_read(rec, BM1387_RX_LEN, 50);
+        if (got == BM1387_RX_LEN && rec[0] == 0x13) {
+            found++;
+        }
+    }
+    return found;
+}
+
+void BM1387::sendChainInactiveUsb()
+{
+    uint8_t inact[5] = {0x55, 0x05, 0x00, 0x00, 0x00};
+    bm1387_frame_cmd(inact, sizeof(inact));
+    for (int i = 0; i < 3; i++) {
+        FTDI_USB_write(inact, sizeof(inact), 200);
+        vTaskDelay(pdMS_TO_TICKS(5));
+    }
+
+    uint16_t chips = (m_detectedChips > 0) ? m_detectedChips : m_expectedChips;
+    if (chips == 0) {
+        chips = 2;
+    }
+    for (uint16_t i = 0; i < chips; i++) {
+        uint8_t addr = (uint8_t)((0x100u / chips) * i);
+        uint8_t setaddr[5] = {0x41, 0x05, addr, 0x00, 0x00};
+        bm1387_frame_cmd(setaddr, sizeof(setaddr));
+        FTDI_USB_write(setaddr, sizeof(setaddr), 200);
+        vTaskDelay(pdMS_TO_TICKS(5));
+    }
+
+    uint8_t gateblk[9] = {0x58, 0x09, 0x00, 0x1C, 0x40, 0x20, 0x80 | BM1387_BAUDDIV_1M5, 0x80, 0x01};
+    bm1387_frame_cmd(gateblk, sizeof(gateblk));
+    FTDI_USB_write(gateblk, sizeof(gateblk), 200);
+    vTaskDelay(pdMS_TO_TICKS(20));
+}
+
+int BM1387::openCoresUsb()
+{
+    uint8_t task[BM1387_TASK_LEN];
+    uint8_t discard[64];
+    int healthy = 0;
+
+    for (int r = 0; r < BM1387_CORES + 2; r++) {
+        bm1387_build_ramp_task((uint8_t)(r % BM1387_MAX_JOB_ID), task);
+        FTDI_USB_write(task, BM1387_TASK_LEN, 200);
+        vTaskDelay(pdMS_TO_TICKS(12));
+        while (FTDI_USB_read(discard, BM1387_RX_LEN, 1) == BM1387_RX_LEN) {
+            if ((discard[0] == 0x72 && discard[1] == 0x03 && discard[2] == 0xEA && discard[3] == 0x83) ||
+                (discard[0] == 0xE1 && discard[1] == 0x6B && discard[2] == 0xF8 && discard[3] == 0x09)) {
+                healthy++;
+            }
+        }
+    }
+
+    int64_t drain_end = esp_timer_get_time() + 400000;
+    while (esp_timer_get_time() < drain_end) {
+        if (FTDI_USB_read(discard, BM1387_RX_LEN, 20) == BM1387_RX_LEN) {
+            if ((discard[0] == 0x72 && discard[1] == 0x03 && discard[2] == 0xEA && discard[3] == 0x83) ||
+                (discard[0] == 0xE1 && discard[1] == 0x6B && discard[2] == 0xF8 && discard[3] == 0x09)) {
+                healthy++;
+            }
+        }
+    }
+    FTDI_USB_clear_rx();
+    return healthy;
+}
+
+bool BM1387::initHardware(float frequency)
+{
+    if (!FTDI_USB_is_connected()) {
+        return false;
+    }
+
+    ESP_LOGI(TAG, "Initializing GekkoScience NewPac (2x BM1387) over USB...");
+    FTDI_USB_toggle_reset();
+    FTDI_USB_drain(200);
+
+    // Switch BM1387 and FT231X to 1.5 Mbps
+    uint8_t baud[9] = {0x58, 0x09, 0x00, 0x1C, 0x00, 0x20, BM1387_BAUDDIV_1M5, 0x00, 0x19};
+    bm1387_frame_cmd(baud, sizeof(baud));
+    FTDI_USB_write(baud, sizeof(baud), 200);
+    vTaskDelay(pdMS_TO_TICKS(10));
+    FTDI_USB_set_baud_divisor(FTDI_DIV_1M5);
+    vTaskDelay(pdMS_TO_TICKS(10));
+
+    int found = countChipsUsb();
+    ESP_LOGI(TAG, "BM1387 chips detected on NewPac: %d", found);
+    m_detectedChips = (found > 0) ? (uint16_t)found : m_expectedChips;
+
+    float start_freq = (frequency < 200.0f) ? frequency : 200.0f;
+    writePllFrequencyUsb(start_freq);
+    sendChainInactiveUsb();
+
+    int cores = openCoresUsb();
+    ESP_LOGI(TAG, "NewPac open_cores complete (%d known-answer nonces)", cores);
+
+    // Ramp PLL frequency smoothly in 25 MHz steps up to target frequency (e.g. 525 MHz = 120 GH/s)
+    if (frequency > start_freq) {
+        float cur = start_freq;
+        while (cur < frequency) {
+            cur += 25.0f;
+            if (cur > frequency) {
+                cur = frequency;
+            }
+            writePllFrequencyUsb(cur);
+            vTaskDelay(pdMS_TO_TICKS(15));
+        }
+    }
+    m_current_frequency = frequency;
+    FTDI_USB_clear_rx();
+    m_rxLen = 0;
+
+    m_lastNonceTimeUs = esp_timer_get_time();
+    return (found > 0 || cores > 0);
+}
+
+uint8_t BM1387::init(uint64_t frequency, uint16_t asic_count, uint32_t difficulty, uint32_t vrFrequency)
+{
+    (void)difficulty;
+    (void)vrFrequency;
+
+    m_expectedChips = (asic_count > 0) ? asic_count : 2;
+    m_current_frequency = (float)frequency;
+
+    // Wait up to 3 seconds for USB enumeration if plugged in at boot
+    for (int i = 0; i < 30 && !FTDI_USB_is_connected(); i++) {
+        vTaskDelay(pdMS_TO_TICKS(100));
+    }
+
+    if (FTDI_USB_is_connected()) {
+        FTDI_USB_take_reinit_needed();
+        initHardware((float)frequency);
+        return (uint8_t)((m_detectedChips > 0) ? m_detectedChips : m_expectedChips);
+    }
+
+    ESP_LOGW(TAG, "NewPac USB not plugged in yet; will auto-initialize on USB hot-plug");
+    return (uint8_t)m_expectedChips;
+}
