diff --git a/main/boards/newpac.cpp b/main/boards/newpac.cpp
new file mode 100644
index 0000000..c01977e
--- /dev/null
+++ b/main/boards/newpac.cpp
@@ -0,0 +1,245 @@
+#include "board.h"
+#include "newpac.h"
+#include "ftdi_usb.h"
+#include "nvs_config.h"
+#include "esp_log.h"
+#include "driver/gpio.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+
+static const char *TAG = "newpac";
+
+// LilyGO T-Display-S3 W5500 LAN-Adapter pin mapping:
+// SCLK=GPIO2, RST=GPIO3, MOSI=GPIO12, MISO=GPIO16, CS=GPIO21, IRQ=NC (polling)
+static const EthPins kEthPins = {
+    .sclk = GPIO_NUM_2,
+    .mosi = GPIO_NUM_12,
+    .miso = GPIO_NUM_16,
+    .cs   = GPIO_NUM_21,
+    .rst  = GPIO_NUM_3,
+    .irq  = GPIO_NUM_NC
+};
+
+const EthPins *NewPacBoard::getEthPins()
+{
+    return &kEthPins;
+}
+
+NewPacBoard::NewPacBoard() : Board()
+{
+    m_deviceModel = "NewPac";
+    m_miningAgent = "NewPac";
+    m_asicModel   = "BM1387";
+    m_version     = 100;
+    m_asicCount   = 2;
+    m_numFans     = 1;
+
+    m_asicMaxDifficulty         = 1;
+    m_asicMinDifficulty         = 1;
+    m_asicMinDifficultyDualPool = 1;
+
+    m_theme          = new ThemeGeneric();
+    m_hasHashCounter = true;
+
+    m_asicJobIntervalMs = 1500;
+
+    // GekkoScience NewPac (2x BM1387): 100..600 MHz (22.8..136.8 GH/s), default 200 MHz (45.6 GH/s)
+    m_asicFrequencies        = {100, 125, 150, 175, 200, 225, 250, 275, 300, 350, 400, 450, 500};
+    m_asicVoltages           = {1150, 1200, 1250, 1300, 1350, 1400};
+    m_asicFrequency          = 200;
+    m_asicVoltageMillis      = 1200;
+    m_defaultAsicFrequency   = m_asicFrequency;
+    m_defaultAsicVoltageMillis = m_asicVoltageMillis;
+    m_absMaxAsicFrequency    = 600;
+    m_absMinAsicVoltageMillis = 1000;
+    m_absMaxAsicVoltageMillis = 1550;
+    m_ecoAsicFrequency       = 125;
+    m_ecoAsicVoltageMillis   = 1150;
+
+    m_fanInvertPolarity = false;
+    m_fanPerc           = 100;
+    m_flipScreen        = true;
+    m_numTempSensors    = 1;
+
+    m_pidSettings[0].targetTemp = 55;
+    m_pidSettings[0].p          = 600;
+    m_pidSettings[0].i          = 10;
+    m_pidSettings[0].d          = 1000;
+
+    m_vr_maxTemp = 85.0f;
+
+    // USB 5V power envelope
+    m_maxPin      = 15.0f;
+    m_minPin      = 1.0f;
+    m_maxVin      = 5.5f;
+    m_minVin      = 4.5f;
+    m_minCurrentA = 0.0f;
+    m_maxCurrentA = 3.0f;
+
+    m_swarmColorName = "#00e676"; // green
+
+    m_asics = new BM1387();
+    m_vrFrequency = m_defaultVrFrequency = 0;
+
+    // Bring W5500 RST (GPIO3) out of reset before probing LAN-Adapter
+    gpio_config_t rst_io = {};
+    rst_io.intr_type    = GPIO_INTR_DISABLE;
+    rst_io.mode         = GPIO_MODE_OUTPUT;
+    rst_io.pin_bit_mask = (1ULL << GPIO_NUM_3);
+    gpio_config(&rst_io);
+    gpio_set_level(GPIO_NUM_3, 0);
+    vTaskDelay(pdMS_TO_TICKS(20));
+    gpio_set_level(GPIO_NUM_3, 1);
+    vTaskDelay(pdMS_TO_TICKS(100));
+
+    m_hasEth = isEthConnected();
+    if (!m_hasEth) {
+        // Release GPIO3 if no W5500 LAN-Adapter was detected
+        gpio_reset_pin(GPIO_NUM_3);
+    }
+}
+
+bool NewPacBoard::initBoard()
+{
+    Board::initBoard();
+
+    // Initialize ESP32-S3 internal temperature sensor for board thermal monitoring
+    temperature_sensor_config_t temp_cfg = TEMPERATURE_SENSOR_CONFIG_DEFAULT(10, 80);
+    if (temperature_sensor_install(&temp_cfg, &m_tempSensor) == ESP_OK) {
+        temperature_sensor_enable(m_tempSensor);
+    }
+
+    setFanPolarity(m_fanInvertPolarity);
+    setFanSpeedCh(0, (float)m_fanPerc / 100.0f);
+
+    // Start ESP32-S3 USB Host driver for GekkoScience NewPac (FT231X)
+    FTDI_USB_init();
+
+    return true;
+}
+
+bool NewPacBoard::initAsics()
+{
+    if (m_shutdown) {
+        return false;
+    }
+
+    if (!m_asics) {
+        m_asics = new BM1387();
+    }
+
+    m_asics->init(m_asicFrequency, m_asicCount, m_asicMaxDifficulty, 0);
+
+    // Keep m_isInitialized and m_isBuckInitialized true so USB hot-plug works seamlessly
+    m_isInitialized     = true;
+    m_isBuckInitialized = true;
+    return true;
+}
+
+bool NewPacBoard::setVoltage(float core_voltage)
+{
+    if (!validateVoltage(core_voltage)) {
+        return false;
+    }
+    ESP_LOGI(TAG, "NewPac nominal core voltage reference: %.3fV (hardware trimmer controlled on stick)", core_voltage);
+    return true;
+}
+
+void NewPacBoard::setFanSpeedCh(int channel, float perc)
+{
+    if (channel == 0) {
+        m_currentFanSpeed = perc;
+    }
+}
+
+void NewPacBoard::getFanSpeedCh(int channel, uint16_t *rpm)
+{
+    if (rpm) {
+        *rpm = (channel == 0) ? (uint16_t)(m_currentFanSpeed * 3000.0f) : 0;
+    }
+}
+
+void NewPacBoard::setFanPolarity(bool invert)
+{
+    (void)invert;
+}
+
+float NewPacBoard::getTemperature(int index)
+{
+    (void)index;
+    if (m_tempSensor) {
+        float tsens_out = 35.0f;
+        if (temperature_sensor_get_celsius(m_tempSensor, &tsens_out) == ESP_OK) {
+            return tsens_out;
+        }
+    }
+    return 35.0f;
+}
+
+float NewPacBoard::getVRTemp()
+{
+    return 0.0f;
+}
+
+float NewPacBoard::getVRTempInt()
+{
+    return 0.0f;
+}
+
+float NewPacBoard::getVin()
+{
+    return 5.0f;
+}
+
+float NewPacBoard::getPin()
+{
+    if (!FTDI_USB_is_connected() || m_shutdown) {
+        return 0.8f;
+    }
+    // Estimated total USB power (W) for 2x BM1387 at active frequency + T-Display-S3
+    float vcore = (float)m_asicVoltageMillis / 1000.0f;
+    float p_asic = 2.0f * ((float)m_asicFrequency * 0.114f) * 0.048f * (vcore / 1.20f) * (vcore / 1.20f);
+    return 0.8f + p_asic;
+}
+
+float NewPacBoard::getIin()
+{
+    return getPin() / 5.0f;
+}
+
+float NewPacBoard::getVout()
+{
+    return (float)m_asicVoltageMillis / 1000.0f;
+}
+
+float NewPacBoard::getPout()
+{
+    if (!FTDI_USB_is_connected() || m_shutdown) {
+        return 0.0f;
+    }
+    float pin = getPin();
+    return (pin > 0.8f) ? (pin - 0.8f) * 0.90f : 0.0f;
+}
+
+float NewPacBoard::getIout()
+{
+    float vout = getVout();
+    return (vout > 0.1f) ? (getPout() / vout) : 0.0f;
+}
+
+void NewPacBoard::requestBuckTelemtry()
+{
+    // Update per-chip temperature display from MCU sensor so Web UI shows valid chip temps
+    float t = getTemperature(0);
+    for (int i = 0; i < m_asicCount; i++) {
+        setChipTemp(i, t);
+    }
+}
+
+Board::Error NewPacBoard::getFault(uint32_t *status)
+{
+    if (status) {
+        *status = 0;
+    }
+    return Board::Error::NONE;
+}
