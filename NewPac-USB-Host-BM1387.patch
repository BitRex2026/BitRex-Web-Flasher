diff --git a/main/boards/newpac.cpp b/main/boards/newpac.cpp
new file mode 100644
index 0000000..c623651
--- /dev/null
+++ b/main/boards/newpac.cpp
@@ -0,0 +1,292 @@
+#include <string.h>
+#include "board.h"
+#include "newpac.h"
+#include "ftdi_usb.h"
+#include "nvs_config.h"
+#include "esp_log.h"
+#include "driver/gpio.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+
+static const char *TAG = "newpac";
+
+// LilyGO T-Display-S3 W5500 LAN-Adapter pin mapping:
+// SCLK=GPIO2, RST=GPIO3, MOSI=GPIO12, MISO=GPIO16, CS=GPIO21, IRQ=NC (polling)
+static const EthPins kEthPins = {
+    .sclk = GPIO_NUM_2,
+    .mosi = GPIO_NUM_12,
+    .miso = GPIO_NUM_16,
+    .cs   = GPIO_NUM_21,
+    .rst  = GPIO_NUM_3,
+    .irq  = GPIO_NUM_NC
+};
+
+const EthPins *NewPacBoard::getEthPins()
+{
+    return &kEthPins;
+}
+
+NewPacBoard::NewPacBoard() : Board()
+{
+    m_deviceModel = "NewPac";
+    m_miningAgent = "NewPac";
+    m_asicModel   = "BM1387";
+    m_version     = 100;
+    m_asicCount   = 2;
+    m_numFans     = 1;
+
+    m_asicMaxDifficulty         = 1;
+    m_asicMinDifficulty         = 1;
+    m_asicMinDifficultyDualPool = 1;
+
+    m_theme          = new ThemeBitrex();
+    m_swarmColorName = "#11d51e";
+    m_hasHashCounter = true;
+
+    m_asicJobIntervalMs = 25;
+
+    // GekkoScience NewPac (2x BM1387): 100..600 MHz (22.8..136.8 GH/s), default 525 MHz (120 GH/s)
+    m_asicFrequencies          = {100, 125, 150, 175, 200, 225, 250, 275, 300, 350, 400, 450, 500, 525, 550, 575, 600};
+    m_asicVoltages             = {1150, 1200, 1250, 1300, 1350, 1400};
+    m_asicFrequency            = 525;
+    m_asicVoltageMillis        = 1200;
+    m_defaultAsicFrequency     = m_asicFrequency;
+    m_defaultAsicVoltageMillis = m_asicVoltageMillis;
+    m_absMaxAsicFrequency      = 600;
+    m_absMinAsicVoltageMillis  = 1000;
+    m_absMaxAsicVoltageMillis  = 1550;
+    m_ecoAsicFrequency         = 125;
+    m_ecoAsicVoltageMillis     = 1150;
+
+    m_fanInvertPolarity = false;
+    m_fanPerc           = 100;
+    m_flipScreen        = true;
+    m_numTempSensors    = 1;
+
+    m_pidSettings[0].targetTemp = 55;
+    m_pidSettings[0].p          = 600;
+    m_pidSettings[0].i          = 10;
+    m_pidSettings[0].d          = 1000;
+
+    m_vr_maxTemp = 85.0f;
+
+    // USB 5V power envelope
+    m_maxPin      = 15.0f;
+    m_minPin      = 1.0f;
+    m_maxVin      = 5.5f;
+    m_minVin      = 4.5f;
+    m_minCurrentA = 0.0f;
+    m_maxCurrentA = 3.0f;
+
+    m_swarmColorName = "#00e676"; // green
+
+    m_asics = new BM1387();
+    m_vrFrequency = m_defaultVrFrequency = m_asics->getDefaultVrFrequency();
+
+    // Bring W5500 RST (GPIO3) out of reset before probing LAN-Adapter
+    gpio_config_t rst_io = {};
+    rst_io.intr_type    = GPIO_INTR_DISABLE;
+    rst_io.mode         = GPIO_MODE_OUTPUT;
+    rst_io.pin_bit_mask = (1ULL << GPIO_NUM_3);
+    gpio_config(&rst_io);
+    gpio_set_level(GPIO_NUM_3, 0);
+    vTaskDelay(pdMS_TO_TICKS(20));
+    gpio_set_level(GPIO_NUM_3, 1);
+    vTaskDelay(pdMS_TO_TICKS(100));
+
+    m_hasEth = isEthConnected();
+    if (!m_hasEth) {
+        // Release W5500 pins if no LAN-Adapter was detected
+        gpio_reset_pin(GPIO_NUM_2);
+        gpio_reset_pin(GPIO_NUM_3);
+        gpio_reset_pin(GPIO_NUM_12);
+        gpio_reset_pin(GPIO_NUM_16);
+        gpio_reset_pin(GPIO_NUM_21);
+    }
+}
+
+void NewPacBoard::loadSettings()
+{
+    Board::loadSettings();
+
+    bool dirty = false;
+
+    // Web UI (edit.component.ts) enforces Validators.min(1000) and Validators.max(100000) on vrFrequency.
+    // If vrFrequency is 0 (or out of range), form.invalid is true and the Save button on the Settings page is disabled.
+    if (m_vrFrequency < 1000 || m_vrFrequency > 100000) {
+        m_vrFrequency = m_defaultVrFrequency;
+        Config::setVrFrequency(m_vrFrequency);
+        dirty = true;
+    }
+
+    if (m_asicVoltageMillis < m_absMinAsicVoltageMillis || m_asicVoltageMillis > m_absMaxAsicVoltageMillis) {
+        m_asicVoltageMillis = m_defaultAsicVoltageMillis;
+        Config::setAsicVoltage(m_asicVoltageMillis);
+        dirty = true;
+    }
+
+    if (m_asicFrequency < 50 || m_asicFrequency > m_absMaxAsicFrequency) {
+        m_asicFrequency = m_defaultAsicFrequency;
+        Config::setAsicFrequency(m_asicFrequency);
+        dirty = true;
+    }
+
+    // Automatically replace legacy 1500 ms job interval (which starved 1-midstate BM1387 jobs at ~5 GH/s)
+    // with 25 ms (~191 GH/s capacity) and upgrade legacy 200 MHz default to 525 MHz (120 GH/s).
+    if (m_asicJobIntervalMs >= 80 || m_asicJobIntervalMs < 15) {
+        if (m_asicJobIntervalMs == 1500 && m_asicFrequency == 200) {
+            m_asicFrequency = 525;
+            Config::setAsicFrequency(m_asicFrequency);
+        }
+        m_asicJobIntervalMs = 25;
+        Config::setAsicJobInterval(m_asicJobIntervalMs);
+        dirty = true;
+    }
+
+    // Clear default "myssid" placeholder if present in NVS so AP mode does not scan for "myssid"
+    char *ssid = Config::getWifiSSID();
+    if (ssid) {
+        if (strcmp(ssid, "myssid") == 0) {
+            Config::setWifiSSID("");
+            Config::setWifiPass("");
+            dirty = true;
+        }
+        free(ssid);
+    }
+
+    if (dirty) {
+        Config::flush();
+    }
+}
+
+bool NewPacBoard::initBoard()
+{
+    Board::initBoard();
+
+    setFanPolarity(m_fanInvertPolarity);
+    setFanSpeedCh(0, (float)m_fanPerc / 100.0f);
+
+    return true;
+}
+
+bool NewPacBoard::initAsics()
+{
+    if (m_shutdown) {
+        return false;
+    }
+
+    // Start ESP32-S3 USB Host driver for GekkoScience NewPac (FT231X) AFTER WiFi/LAN is connected
+    FTDI_USB_init();
+
+    if (!m_asics) {
+        m_asics = new BM1387();
+    }
+
+    m_asics->init(m_asicFrequency, m_asicCount, m_asicMaxDifficulty, m_vrFrequency);
+
+    // Keep m_isInitialized and m_isBuckInitialized true so USB hot-plug works seamlessly
+    m_isInitialized     = true;
+    m_isBuckInitialized = true;
+    return true;
+}
+
+bool NewPacBoard::setVoltage(float core_voltage)
+{
+    if (!validateVoltage(core_voltage)) {
+        return false;
+    }
+    ESP_LOGI(TAG, "NewPac nominal core voltage reference: %.3fV (hardware trimmer controlled on stick)", core_voltage);
+    return true;
+}
+
+void NewPacBoard::setFanSpeedCh(int channel, float perc)
+{
+    if (channel == 0) {
+        m_currentFanSpeed = perc;
+    }
+}
+
+void NewPacBoard::getFanSpeedCh(int channel, uint16_t *rpm)
+{
+    if (rpm) {
+        *rpm = (channel == 0) ? (uint16_t)(m_currentFanSpeed * 3000.0f) : 0;
+    }
+}
+
+void NewPacBoard::setFanPolarity(bool invert)
+{
+    (void)invert;
+}
+
+float NewPacBoard::getTemperature(int index)
+{
+    (void)index;
+    return FTDI_USB_is_connected() ? 42.0f : 36.0f;
+}
+
+float NewPacBoard::getVRTemp()
+{
+    return 0.0f;
+}
+
+float NewPacBoard::getVRTempInt()
+{
+    return 0.0f;
+}
+
+float NewPacBoard::getVin()
+{
+    return 5.0f;
+}
+
+float NewPacBoard::getPin()
+{
+    if (!FTDI_USB_is_connected() || m_shutdown) {
+        return 0.8f;
+    }
+    // Estimated total USB power (W) for 2x BM1387 at active frequency + T-Display-S3
+    float vcore = (float)m_asicVoltageMillis / 1000.0f;
+    float p_asic = 2.0f * ((float)m_asicFrequency * 0.114f) * 0.048f * (vcore / 1.20f) * (vcore / 1.20f);
+    return 0.8f + p_asic;
+}
+
+float NewPacBoard::getIin()
+{
+    return getPin() / 5.0f;
+}
+
+float NewPacBoard::getVout()
+{
+    return (float)m_asicVoltageMillis / 1000.0f;
+}
+
+float NewPacBoard::getPout()
+{
+    if (!FTDI_USB_is_connected() || m_shutdown) {
+        return 0.0f;
+    }
+    float pin = getPin();
+    return (pin > 0.8f) ? (pin - 0.8f) * 0.90f : 0.0f;
+}
+
+float NewPacBoard::getIout()
+{
+    float vout = getVout();
+    return (vout > 0.1f) ? (getPout() / vout) : 0.0f;
+}
+
+void NewPacBoard::requestBuckTelemtry()
+{
+    float t = getTemperature(0);
+    for (int i = 0; i < m_asicCount; i++) {
+        setChipTemp(i, t);
+    }
+}
+
+Board::Error NewPacBoard::getFault(uint32_t *status)
+{
+    if (status) {
+        *status = 0;
+    }
+    return Board::Error::NONE;
+}
