+bool BM1387::setAsicFrequency(float frequency)
+{
+    if (frequency < 50.0f) {
+        frequency = 50.0f;
+    }
+    if (frequency > 900.0f) {
+        frequency = 900.0f;
+    }
+    float actual = ceilf(100.0f * frequency / 625.0f) * 6.25f;
+
+    uint8_t buf[9] = {0x58, 0x09, 0x00, 0x0C, 0x00, 0x50, 0x02, 0x41, 0x00};
+    if (actual < 400.0f) {
+        buf[7] = 0x41;
+        buf[5] = (uint8_t)(actual * 8.0f / 25.0f);
+    } else if (actual < 600.0f) {
+        buf[7] = 0x21;
+        buf[5] = (uint8_t)(actual * 4.0f / 25.0f);
+    } else {
+        buf[7] = 0x11;
+        buf[5] = (uint8_t)(actual * 2.0f / 25.0f);
+    }
+    bm1387_frame_cmd(buf, sizeof(buf));
+
+    m_current_frequency = frequency;
+    m_actual_current_frequency = actual;
+
+    if (FTDI_USB_is_connected()) {
+        FTDI_USB_write(buf, sizeof(buf), 200);
+        vTaskDelay(pdMS_TO_TICKS(20));
+        ESP_LOGI(TAG, "BM1387 PLL frequency set to %.2f MHz", actual);
+    }
+    return true;
+}
