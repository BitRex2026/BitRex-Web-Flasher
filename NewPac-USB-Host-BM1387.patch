+
+uint8_t BM1387::sendWork(uint32_t job_id, bm_job *next_bm_job)
+{
+    uint8_t id = jobToAsicId((uint8_t)job_id);
+
+    if (!FTDI_USB_is_connected()) {
+        return id;
+    }
+
+    // Auto-initialize on USB hot-plug or after 30s zombie timeout
+    int64_t now = esp_timer_get_time();
+    bool zombie = (m_lastNonceTimeUs > 0) && ((now - m_lastNonceTimeUs) > 30000000LL);
+    if (FTDI_USB_take_reinit_needed() || zombie) {
+        if (zombie) {
+            ESP_LOGW(TAG, "No nonces from NewPac for 30s (zombie check) — reinitializing USB ASICs");
+        }
+        initHardware(m_current_frequency);
+    }
+
+    uint8_t header80[80];
+    memcpy(header80,      &next_bm_job->version,        4);
+    memcpy(header80 + 4,  next_bm_job->prev_block_hash, 32);
+    memcpy(header80 + 36, next_bm_job->merkle_root,     32);
+    memcpy(header80 + 68, &next_bm_job->ntime,          4);
+    memcpy(header80 + 72, &next_bm_job->target,         4);
+    memset(header80 + 76, 0,                            4);
+
+    // Save 76-byte header prefix for cryptographic diff-1 nonce verification & stream alignment
+    memcpy(m_jobHeaders[id], header80, 76);
+    m_jobValid[id] = true;
+
+    uint8_t task[BM1387_TASK_LEN];
+    bm1387_build_task(header80, id, task);
+    FTDI_USB_write(task, BM1387_TASK_LEN, 200);
+    m_lastWorkTimeUs = now;
+
+    return id;
+}
+
+bool BM1387::processWork(task_result *result)
+{
+    // Emit synthetic 0x90 (nonce count) register replies when requested by HashrateMonitor
+    if (m_pendingReg90Mask) {
+        for (int ch = 0; ch < 2; ch++) {
+            if (m_pendingReg90Mask & (1u << ch)) {
+                m_pendingReg90Mask &= ~(1u << ch);
+                memset(result, 0, sizeof(task_result));
+                result->is_reg_resp = 1;
+                result->reg         = 0x90;
+                result->asic_nr     = ch;
+                result->data        = m_diff1Counter[ch];
+                return true;
+            }
+        }
+    }
+
+    // Emit synthetic 0x4C (hw error count) register replies when requested by HashrateMonitor
+    if (m_pendingReg4CMask) {
+        for (int ch = 0; ch < 2; ch++) {
+            if (m_pendingReg4CMask & (1u << ch)) {
+                m_pendingReg4CMask &= ~(1u << ch);
+                memset(result, 0, sizeof(task_result));
+                result->is_reg_resp = 1;
+                result->reg         = 0x4C;
+                result->asic_nr     = ch;
+                result->data        = m_hwErrorCounter[ch];
+                return true;
+            }
+        }
+    }
+
+    if (!FTDI_USB_is_connected()) {
+        m_rxLen = 0;
+        vTaskDelay(pdMS_TO_TICKS(50));
+        return false;
+    }
+
+    if (m_rxLen < BM1387_RX_LEN) {
+        int got = FTDI_USB_read(m_rxBuf + m_rxLen, BM1387_RX_LEN - m_rxLen, 30);
+        if (got > 0) {
+            m_rxLen += got;
+        }
+        if (m_rxLen < BM1387_RX_LEN) {
+            return false;
+        }
+    }
+
+    // Sliding window resync: every valid 7-byte BM1387 packet (command or nonce)
+    // has a valid 5-bit CRC in m_rxBuf[6] & 0x1F. If misaligned, slide 1 byte at a time
+    // without discarding remaining buffered bytes.
+    for (int slip = 0; slip < 7; slip++) {
+        if (bm1387_is_crc5_ok(m_rxBuf)) {
+            uint8_t rec[BM1387_RX_LEN];
+            memcpy(rec, m_rxBuf, BM1387_RX_LEN);
+            m_rxLen = 0;
+
+            if (rec[6] <= 0x1F) {
+                // Command response packet
+                return false;
+            }
+            if ((rec[0] == 0x72 && rec[1] == 0x03 && rec[2] == 0xEA && rec[3] == 0x83) ||
+                (rec[0] == 0xE1 && rec[1] == 0x6B && rec[2] == 0xF8 && rec[3] == 0x09)) {
+                // Busy / open-core nonce
+                return false;
+            }
+            uint8_t job_id  = rec[5] & BM1387_MAX_JOB_ID;
+            int     asic_nr = (rec[0] & 0x80) ? 1 : 0;
+            if (verifyDiff1Nonce(job_id, rec)) {
+                uint32_t nonce = 0;
+                memcpy(&nonce, rec, 4);
+
+                m_lastNonceTimeUs = esp_timer_get_time();
+                m_diff1Counter[asic_nr]++;
+
+                memset(result, 0, sizeof(task_result));
+                result->is_reg_resp    = 0;
+                result->job_id         = job_id;
+                result->asic_nr        = asic_nr;
+                result->nonce          = nonce;
+                result->rolled_version = 0;
+                return true;
+            } else {
+                m_hwErrorCounter[asic_nr]++;
+                return false;
+            }
+        }
+        // Shift window by 1 byte without dropping remaining 6 bytes
+        memmove(m_rxBuf, m_rxBuf + 1, BM1387_RX_LEN - 1);
+        m_rxLen = BM1387_RX_LEN - 1;
+        if (FTDI_USB_read(m_rxBuf + BM1387_RX_LEN - 1, 1, 10) != 1) {
+            break;
+        }
+        m_rxLen = BM1387_RX_LEN;
+    }
+
+    return false;
+}
+
+void BM1387::resetCounter(uint8_t reg)
+{
+    if (reg == 0x90) {
+        m_diff1Counter[0] = 0;
+        m_diff1Counter[1] = 0;
+    } else if (reg == 0x4C) {
+        m_hwErrorCounter[0] = 0;
+        m_hwErrorCounter[1] = 0;
+    }
+}
+
+void BM1387::readCounter(uint8_t reg)
+{
+    if (reg == 0x90) {
+        m_pendingReg90Mask = 0x03; // chip 0 and chip 1
+    } else if (reg == 0x4C) {
+        m_pendingReg4CMask = 0x03; // chip 0 and chip 1
+    }
+}
diff --git a/components/bm1397/ftdi_usb.cpp b/components/bm1397/ftdi_usb.cpp
new file mode 100644
index 0000000..9f050aa
--- /dev/null
+++ b/components/bm1397/ftdi_usb.cpp
@@ -0,0 +1,573 @@
+#include "ftdi_usb.h"
+
+#include <string.h>
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+#include "freertos/semphr.h"
+#include "freertos/stream_buffer.h"
+#include "esp_log.h"
+#include "esp_timer.h"
+#include "usb/usb_host.h"
+
+static const char *TAG = "ftdi_usb";
+
+// FTDI USB Vendor / Product IDs
+#define FTDI_VID        0x0403
+#define FTDI_PID_FT231X 0x6015
+#define FTDI_PID_FT232R 0x6001
+#define FTDI_PID_FT2232 0x6010
+#define FTDI_PID_FT232H 0x6014
+
+// FTDI Vendor Control Requests (bmRequestType = 0x40)
+#define FTDI_TYPE_OUT       0x40
+#define FTDI_REQ_RESET      0x00
+#define FTDI_REQ_MODEM      0x01
+#define FTDI_REQ_FLOW       0x02
+#define FTDI_REQ_BAUD       0x03
+#define FTDI_REQ_DATA       0x04
+#define FTDI_REQ_LATENCY    0x09
+#define FTDI_REQ_BITMODE    0x0B
+
+#define FTDI_VAL_RESET      0x0000
+#define FTDI_VAL_PURGE_RX   0x0001
+#define FTDI_VAL_PURGE_TX   0x0002
+#define FTDI_VAL_DATA_8N1   0x0008
+#define FTDI_VAL_FLOW_NONE  0x0000
+
+#define FTDI_BITMODE_RESET  0x00
+#define FTDI_BITMODE_CBUS   0x20
+
+#define FTDI_PACKET_SIZE    64
+#define FTDI_STATUS_BYTES   2
+#define FTDI_NUM_IN_URBS    2
+#define FTDI_RX_BUF_SIZE    4096
+
+static usb_host_client_handle_t s_client_hdl = nullptr;
+static usb_device_handle_t      s_dev_hdl    = nullptr;
+static uint8_t                  s_intf_num   = 0;
+static uint8_t                  s_ep_in      = 0;
+static uint8_t                  s_ep_out     = 0;
+static uint16_t                 s_ep_in_mps  = FTDI_PACKET_SIZE;
+
+static volatile bool s_inited       = false;
+static volatile bool s_connected    = false;
+static volatile bool s_needs_reinit = false;
+static volatile uint8_t s_pending_dev_addr = 0;
+static volatile bool    s_pending_dev_gone = false;
+
+static usb_transfer_t *s_ctrl_transfer = nullptr;
+static usb_transfer_t *s_out_transfer  = nullptr;
+static usb_transfer_t *s_in_transfer[FTDI_NUM_IN_URBS] = {nullptr, nullptr};
+static volatile bool   s_in_inflight[FTDI_NUM_IN_URBS] = {false, false};
+
+static SemaphoreHandle_t    s_ctrl_mutex    = nullptr;
+static SemaphoreHandle_t    s_ctrl_done_sem = nullptr;
+static SemaphoreHandle_t    s_tx_mutex      = nullptr;
+static SemaphoreHandle_t    s_out_done_sem  = nullptr;
+static StreamBufferHandle_t s_rx_stream     = nullptr;
+
+static bool is_supported_ftdi(uint16_t vid, uint16_t pid)
+{
+    if (vid != FTDI_VID) {
+        return false;
+    }
+    return (pid == FTDI_PID_FT231X ||
+            pid == FTDI_PID_FT232R ||
+            pid == FTDI_PID_FT2232 ||
+            pid == FTDI_PID_FT232H);
+}
+
+static void ctrl_transfer_cb(usb_transfer_t *transfer)
+{
+    if (s_ctrl_done_sem) {
+        xSemaphoreGive(s_ctrl_done_sem);
+    }
+}
+
+static void out_transfer_cb(usb_transfer_t *transfer)
+{
+    if (s_out_done_sem) {
+        xSemaphoreGive(s_out_done_sem);
+    }
+}
+
+static void in_transfer_cb(usb_transfer_t *transfer)
+{
+    int idx = (int)(intptr_t)transfer->context;
+    if (idx >= 0 && idx < FTDI_NUM_IN_URBS) {
+        s_in_inflight[idx] = false;
+    }
+
+    if (!s_connected || !s_dev_hdl) {
+        return;
+    }
+
+    if (transfer->status == USB_TRANSFER_STATUS_COMPLETED) {
+        int total = transfer->actual_num_bytes;
+        int mps = (s_ep_in_mps > 0) ? s_ep_in_mps : FTDI_PACKET_SIZE;
+        // Strip the 2 modem-status bytes at the start of each MPS-sized USB packet
+        for (int offset = 0; offset < total; offset += mps) {
+            int pkt_len = total - offset;
+            if (pkt_len > mps) {
+                pkt_len = mps;
+            }
+            if (pkt_len > FTDI_STATUS_BYTES && s_rx_stream) {
+                xStreamBufferSend(s_rx_stream,
+                                  transfer->data_buffer + offset + FTDI_STATUS_BYTES,
+                                  pkt_len - FTDI_STATUS_BYTES,
+                                  0);
+            }
+        }
+    } else if (transfer->status == USB_TRANSFER_STATUS_NO_DEVICE ||
+               transfer->status == USB_TRANSFER_STATUS_CANCELED) {
+        return;
+    }
+
+    // Re-submit Bulk-IN transfer if still connected
+    if (s_connected && s_dev_hdl) {
+        transfer->device_handle    = s_dev_hdl;
+        transfer->bEndpointAddress = s_ep_in;
+        transfer->num_bytes        = s_ep_in_mps;
+        if (usb_host_transfer_submit(transfer) == ESP_OK) {
+            if (idx >= 0 && idx < FTDI_NUM_IN_URBS) {
+                s_in_inflight[idx] = true;
+            }
+        }
+    }
+}
+
+static void close_current_device(void)
+{
+    if (!s_dev_hdl) {
+        s_connected = false;
+        return;
+    }
+
+    ESP_LOGW(TAG, "Closing FTDI USB device");
+    s_connected = false;
+
+    if (s_ep_in) {
+        usb_host_endpoint_halt(s_dev_hdl, s_ep_in);
+        usb_host_endpoint_flush(s_dev_hdl, s_ep_in);
+    }
+    if (s_ep_out) {
+        usb_host_endpoint_halt(s_dev_hdl, s_ep_out);
+        usb_host_endpoint_flush(s_dev_hdl, s_ep_out);
+    }
+
+    for (int wait = 0; wait < 20; wait++) {
+        if (!s_in_inflight[0] && !s_in_inflight[1]) {
+            break;
+        }
+        usb_host_client_handle_events(s_client_hdl, pdMS_TO_TICKS(5));
+    }
+
+    usb_host_interface_release(s_client_hdl, s_dev_hdl, s_intf_num);
+    usb_host_device_close(s_client_hdl, s_dev_hdl);
+
+    s_dev_hdl = nullptr;
+    s_ep_in   = 0;
+    s_ep_out  = 0;
+}
+
+static void try_open_device(uint8_t dev_addr)
+{
+    if (s_dev_hdl || dev_addr == 0) {
+        return;
+    }
+
+    usb_device_handle_t dev_hdl = nullptr;
+    esp_err_t err = usb_host_device_open(s_client_hdl, dev_addr, &dev_hdl);
+    if (err != ESP_OK || !dev_hdl) {
+        ESP_LOGW(TAG, "usb_host_device_open(addr=%u) failed: %s", dev_addr, esp_err_to_name(err));
+        return;
+    }
+
+    const usb_device_desc_t *dev_desc = nullptr;
+    err = usb_host_get_device_descriptor(dev_hdl, &dev_desc);
+    if (err != ESP_OK || !dev_desc) {
+        usb_host_device_close(s_client_hdl, dev_hdl);
+        return;
+    }
+
+    ESP_LOGI(TAG, "USB device addr=%u VID=0x%04X PID=0x%04X",
+             dev_addr, dev_desc->idVendor, dev_desc->idProduct);
+
+    if (!is_supported_ftdi(dev_desc->idVendor, dev_desc->idProduct)) {
+        // Not an FTDI device (e.g. external USB hub); close handle immediately
+        usb_host_device_close(s_client_hdl, dev_hdl);
+        return;
+    }
+
+    const usb_config_desc_t *cfg_desc = nullptr;
+    err = usb_host_get_active_config_descriptor(dev_hdl, &cfg_desc);
+    if (err != ESP_OK || !cfg_desc) {
+        ESP_LOGE(TAG, "usb_host_get_active_config_descriptor failed");
+        usb_host_device_close(s_client_hdl, dev_hdl);
+        return;
+    }
+
+    int offset = 0;
+    const usb_intf_desc_t *intf_desc = usb_parse_interface_descriptor(cfg_desc, 0, 0, &offset);
+    if (!intf_desc) {
+        ESP_LOGE(TAG, "Interface 0 not found on FTDI device");
+        usb_host_device_close(s_client_hdl, dev_hdl);
+        return;
+    }
+
+    s_intf_num  = intf_desc->bInterfaceNumber;
+    s_ep_in     = 0;
+    s_ep_out    = 0;
+    s_ep_in_mps = FTDI_PACKET_SIZE;
+
+    for (int i = 0; i < intf_desc->bNumEndpoints; i++) {
+        int ep_offset = offset;
+        const usb_ep_desc_t *ep = usb_parse_endpoint_descriptor_by_index(
+            intf_desc, i, cfg_desc->wTotalLength, &ep_offset);
+        if (!ep) {
+            continue;
+        }
+        if ((ep->bmAttributes & USB_BM_ATTRIBUTES_XFERTYPE_MASK) == USB_BM_ATTRIBUTES_XFER_BULK) {
+            if (ep->bEndpointAddress & 0x80) {
+                s_ep_in     = ep->bEndpointAddress;
+                s_ep_in_mps = (ep->wMaxPacketSize > 0 && ep->wMaxPacketSize <= FTDI_PACKET_SIZE)
+                                  ? ep->wMaxPacketSize
+                                  : FTDI_PACKET_SIZE;
+            } else {
+                s_ep_out = ep->bEndpointAddress;
+            }
+        }
+    }
+
+    if (!s_ep_in || !s_ep_out) {
+        ESP_LOGE(TAG, "FTDI bulk endpoints not found (in=0x%02X out=0x%02X)", s_ep_in, s_ep_out);
+        usb_host_device_close(s_client_hdl, dev_hdl);
+        return;
+    }
+
+    err = usb_host_interface_claim(s_client_hdl, dev_hdl, s_intf_num, 0);
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "usb_host_interface_claim failed: %s", esp_err_to_name(err));
+        usb_host_device_close(s_client_hdl, dev_hdl);
+        return;
+    }
+
+    s_dev_hdl   = dev_hdl;
+    s_connected = true;
+    xStreamBufferReset(s_rx_stream);
+
+    // Submit Bulk-IN transfers to start receiving data continuously
+    for (int i = 0; i < FTDI_NUM_IN_URBS; i++) {
+        s_in_transfer[i]->device_handle    = s_dev_hdl;
+        s_in_transfer[i]->bEndpointAddress = s_ep_in;
+        s_in_transfer[i]->num_bytes        = s_ep_in_mps;
+        s_in_transfer[i]->callback         = in_transfer_cb;
+        s_in_transfer[i]->context          = (void *)(intptr_t)i;
+        if (usb_host_transfer_submit(s_in_transfer[i]) == ESP_OK) {
+            s_in_inflight[i] = true;
+        }
+    }
+
+    s_needs_reinit = true;
+    ESP_LOGI(TAG, "GekkoScience NewPac (FTDI 0x%04X:0x%04X) connected! EP_IN=0x%02X EP_OUT=0x%02X",
+             dev_desc->idVendor, dev_desc->idProduct, s_ep_in, s_ep_out);
+}
+
+static void client_event_cb(const usb_host_client_event_msg_t *event_msg, void *arg)
+{
+    switch (event_msg->event) {
+    case USB_HOST_CLIENT_EVENT_NEW_DEV:
+        s_pending_dev_addr = event_msg->new_dev.address;
+        break;
+    case USB_HOST_CLIENT_EVENT_DEV_GONE:
+        if (s_dev_hdl && event_msg->dev_gone.dev_hdl == s_dev_hdl) {
+            s_pending_dev_gone = true;
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+static void usb_host_daemon_task(void *arg)
+{
+    ESP_LOGI(TAG, "USB Host library daemon started");
+    while (1) {
+        uint32_t event_flags = 0;
+        usb_host_lib_handle_events(portMAX_DELAY, &event_flags);
+    }
+}
+
+static void usb_ftdi_client_task(void *arg)
+{
+    usb_host_client_config_t client_cfg = {};
+    client_cfg.is_synchronous = false;
+    client_cfg.max_num_event_msg = 5;
+    client_cfg.async.client_event_callback = client_event_cb;
+    client_cfg.async.callback_arg = nullptr;
+
+    ESP_ERROR_CHECK(usb_host_client_register(&client_cfg, &s_client_hdl));
+    ESP_LOGI(TAG, "USB Host FTDI client registered");
+
+    // Check if any USB devices were already enumerated before client registration
+    uint8_t dev_list[8] = {0};
+    int num_devs = 0;
+    if (usb_host_device_addr_list_fill(sizeof(dev_list), dev_list, &num_devs) == ESP_OK) {
+        for (int i = 0; i < num_devs; i++) {
+            try_open_device(dev_list[i]);
+        }
+    }
+
+    while (1) {
+        usb_host_client_handle_events(s_client_hdl, pdMS_TO_TICKS(20));
+
+        if (s_pending_dev_gone) {
+            s_pending_dev_gone = false;
+            close_current_device();
+        }
+
+        if (s_pending_dev_addr != 0) {
+            uint8_t addr = s_pending_dev_addr;
+            s_pending_dev_addr = 0;
+            try_open_device(addr);
+        }
+    }
+}
+
+bool FTDI_USB_init(void)
+{
+    if (s_inited) {
+        return true;
+    }
+
+    s_ctrl_mutex    = xSemaphoreCreateMutex();
+    s_ctrl_done_sem = xSemaphoreCreateBinary();
+    s_tx_mutex      = xSemaphoreCreateMutex();
+    s_out_done_sem  = xSemaphoreCreateBinary();
+    s_rx_stream     = xStreamBufferCreate(FTDI_RX_BUF_SIZE, 1);
+
+    if (!s_ctrl_mutex || !s_ctrl_done_sem || !s_tx_mutex || !s_out_done_sem || !s_rx_stream) {
+        ESP_LOGE(TAG, "Failed to allocate synchronization primitives");
+        return false;
+    }
+
+    usb_host_config_t host_cfg = {};
+    host_cfg.skip_phy_setup = false;
+    host_cfg.intr_flags     = ESP_INTR_FLAG_LEVEL1;
+
+    esp_err_t err = usb_host_install(&host_cfg);
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "usb_host_install failed: %s", esp_err_to_name(err));
+        return false;
+    }
+
+    if (usb_host_transfer_alloc(64, 0, &s_ctrl_transfer) != ESP_OK ||
+        usb_host_transfer_alloc(256, 0, &s_out_transfer) != ESP_OK ||
+        usb_host_transfer_alloc(FTDI_PACKET_SIZE, 0, &s_in_transfer[0]) != ESP_OK ||
+        usb_host_transfer_alloc(FTDI_PACKET_SIZE, 0, &s_in_transfer[1]) != ESP_OK) {
+        ESP_LOGE(TAG, "Failed to allocate USB transfers");
+        return false;
+    }
+
+    // Pin USB Host tasks to Core 1 at moderate priority so Core 0 remains 100% free for Wi-Fi / LwIP
+    xTaskCreatePinnedToCore(usb_host_daemon_task, "usb_daemon", 4096, nullptr, 6, nullptr, 1);
+    xTaskCreatePinnedToCore(usb_ftdi_client_task, "usb_ftdi",   4096, nullptr, 5, nullptr, 1);
+
+    s_inited = true;
+    return true;
+}
+
+bool FTDI_USB_is_connected(void)
+{
+    return s_connected && (s_dev_hdl != nullptr);
+}
+
+bool FTDI_USB_take_reinit_needed(void)
+{
+    if (s_connected && s_needs_reinit) {
+        s_needs_reinit = false;
+        return true;
+    }
+    return false;
+}
+
+void FTDI_USB_request_reinit(void)
+{
+    if (s_connected) {
+        s_needs_reinit = true;
+    }
+}
+
+static bool ftdi_ctrl_out(uint8_t request, uint16_t value, uint16_t index)
+{
+    if (!FTDI_USB_is_connected()) {
+        return false;
+    }
+
+    if (xSemaphoreTake(s_ctrl_mutex, pdMS_TO_TICKS(1000)) != pdTRUE) {
+        return false;
+    }
+
+    xSemaphoreTake(s_ctrl_done_sem, 0);
+
+    usb_setup_packet_t *setup = (usb_setup_packet_t *)s_ctrl_transfer->data_buffer;
+    setup->bmRequestType = FTDI_TYPE_OUT;
+    setup->bRequest      = request;
+    setup->wValue        = value;
+    setup->wIndex        = index;
+    setup->wLength       = 0;
+
+    s_ctrl_transfer->device_handle    = s_dev_hdl;
+    s_ctrl_transfer->bEndpointAddress = 0;
+    s_ctrl_transfer->num_bytes        = sizeof(usb_setup_packet_t);
+    s_ctrl_transfer->callback         = ctrl_transfer_cb;
+    s_ctrl_transfer->context          = nullptr;
+
+    esp_err_t err = usb_host_transfer_submit_control(s_client_hdl, s_ctrl_transfer);
+    bool ok = false;
+    if (err == ESP_OK) {
+        if (xSemaphoreTake(s_ctrl_done_sem, pdMS_TO_TICKS(1000)) == pdTRUE) {
+            ok = (s_ctrl_transfer->status == USB_TRANSFER_STATUS_COMPLETED);
+        }
+    } else {
+        ESP_LOGW(TAG, "ctrl submit (req=0x%02X val=0x%04X) failed: %s",
+                 request, value, esp_err_to_name(err));
+    }
+
+    xSemaphoreGive(s_ctrl_mutex);
+    return ok;
+}
+
+bool FTDI_USB_set_baud_divisor(uint16_t divisor)
+{
+    return ftdi_ctrl_out(FTDI_REQ_BAUD, divisor, s_intf_num);
+}
+
+bool FTDI_USB_purge(void)
+{
+    bool ok1 = ftdi_ctrl_out(FTDI_REQ_RESET, FTDI_VAL_PURGE_TX, s_intf_num);
+    bool ok2 = ftdi_ctrl_out(FTDI_REQ_RESET, FTDI_VAL_PURGE_RX, s_intf_num);
+    FTDI_USB_clear_rx();
+    return ok1 && ok2;
+}
+
+bool FTDI_USB_configure(uint16_t divisor)
+{
+    if (!FTDI_USB_is_connected()) {
+        return false;
+    }
+    ftdi_ctrl_out(FTDI_REQ_RESET,   FTDI_VAL_RESET,     s_intf_num);
+    ftdi_ctrl_out(FTDI_REQ_DATA,    FTDI_VAL_DATA_8N1,  s_intf_num);
+    FTDI_USB_set_baud_divisor(divisor);
+    ftdi_ctrl_out(FTDI_REQ_FLOW,    FTDI_VAL_FLOW_NONE, s_intf_num);
+    ftdi_ctrl_out(FTDI_REQ_LATENCY, 2,                  s_intf_num); // 2 ms latency timer
+    return FTDI_USB_purge();
+}
+
+bool FTDI_USB_set_cbus(uint8_t mask)
+{
+    uint16_t val = ((uint16_t)FTDI_BITMODE_CBUS << 8) | mask;
+    return ftdi_ctrl_out(FTDI_REQ_BITMODE, val, s_intf_num);
+}
+
+bool FTDI_USB_toggle_reset(void)
+{
+    if (!FTDI_USB_configure(FTDI_DIV_115200)) {
+        return false;
+    }
+    // Pulse ASIC nRST on FT231X CBUS1 (CB1): high (0xF2) -> low (0xF0) -> high (0xF2)
+    FTDI_USB_set_cbus(0xF2);
+    vTaskDelay(pdMS_TO_TICKS(30));
+    FTDI_USB_set_cbus(0xF0);
+    vTaskDelay(pdMS_TO_TICKS(30));
+    FTDI_USB_set_cbus(0xF2);
+    vTaskDelay(pdMS_TO_TICKS(30));
+    return true;
+}
+
+void FTDI_USB_clear_rx(void)
+{
+    if (s_rx_stream) {
+        xStreamBufferReset(s_rx_stream);
+    }
+}
+
+void FTDI_USB_drain(uint32_t duration_ms)
+{
+    int64_t end_us = esp_timer_get_time() + (int64_t)duration_ms * 1000;
+    uint8_t discard[64];
+    while (esp_timer_get_time() < end_us) {
+        xStreamBufferReceive(s_rx_stream, discard, sizeof(discard), pdMS_TO_TICKS(10));
+    }
+    FTDI_USB_clear_rx();
+}
+
+int FTDI_USB_write(const uint8_t *data, int len, uint32_t timeout_ms)
+{
+    if (!FTDI_USB_is_connected() || !data || len <= 0) {
+        return -1;
+    }
+    if (len > (int)s_out_transfer->data_buffer_size) {
+        len = (int)s_out_transfer->data_buffer_size;
+    }
+
+    if (xSemaphoreTake(s_tx_mutex, pdMS_TO_TICKS(timeout_ms)) != pdTRUE) {
+        return -1;
+    }
+
+    xSemaphoreTake(s_out_done_sem, 0);
+
+    memcpy(s_out_transfer->data_buffer, data, len);
+    s_out_transfer->device_handle    = s_dev_hdl;
+    s_out_transfer->bEndpointAddress = s_ep_out;
+    s_out_transfer->num_bytes        = len;
+    s_out_transfer->callback         = out_transfer_cb;
+    s_out_transfer->context          = nullptr;
+
+    int written = -1;
+    esp_err_t err = usb_host_transfer_submit(s_out_transfer);
+    if (err == ESP_OK) {
+        if (xSemaphoreTake(s_out_done_sem, pdMS_TO_TICKS(timeout_ms)) == pdTRUE) {
+            if (s_out_transfer->status == USB_TRANSFER_STATUS_COMPLETED) {
+                written = s_out_transfer->actual_num_bytes;
+            }
+        }
+    }
+
+    xSemaphoreGive(s_tx_mutex);
+    return written;
+}
+
+int FTDI_USB_read(uint8_t *buf, int len, uint32_t timeout_ms)
+{
+    if (!s_rx_stream || !buf || len <= 0) {
+        return 0;
+    }
+
+    int total = 0;
+    int64_t deadline_us = esp_timer_get_time() + (int64_t)timeout_ms * 1000;
+
+    while (total < len) {
+        int64_t rem_us = deadline_us - esp_timer_get_time();
+        if (rem_us <= 0) {
+            break;
+        }
+        uint32_t wait_ms = (uint32_t)(rem_us / 1000);
+        if (wait_ms == 0) {
+            wait_ms = 1;
+        }
+        TickType_t wait_ticks = pdMS_TO_TICKS(wait_ms);
+        if (wait_ticks == 0) {
+            wait_ticks = 1;
+        }
+        size_t got = xStreamBufferReceive(s_rx_stream,
+                                          buf + total,
+                                          len - total,
+                                          wait_ticks);
+        if (got == 0) {
+            break;
+        }
+        total += (int)got;
+    }
+    return total;
+}
