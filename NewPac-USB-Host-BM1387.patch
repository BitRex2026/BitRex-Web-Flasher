+
+class BM1387 : public Asic {
+private:
+    uint16_t m_expectedChips = 2;
+    uint16_t m_detectedChips = 0;
+    volatile uint32_t m_diff1Counter[2] = {0, 0};
+    volatile uint32_t m_hwErrorCounter[2] = {0, 0};
+    volatile uint8_t  m_pendingReg90Mask = 0;
+    volatile uint8_t  m_pendingReg4CMask = 0;
+    int64_t  m_lastNonceTimeUs = 0;
+    int64_t  m_lastWorkTimeUs  = 0;
+
+    uint8_t  m_jobHeaders[128][76];
+    bool     m_jobValid[128];
+
+    bool initHardware(float frequency);
+    int  countChipsUsb();
+    void sendChainInactiveUsb();
+    int  openCoresUsb();
+    bool verifyDiff1Nonce(uint8_t job_id, const uint8_t nonce_bytes[4]);
+
+protected:
+    virtual const uint8_t* getChipId() override;
+    virtual uint8_t jobToAsicId(uint8_t job_id) override;
+    virtual uint8_t asicToJobId(uint8_t asic_id) override;
+    virtual int nonceToAsic(uint32_t nonce) override;
+
+public:
+    BM1387();
+    virtual ~BM1387() = default;
+
+    virtual const char* getName() override {
+        return "BM1387";
+    }
+
+    virtual uint16_t getSmallCoreCount() override {
+        return 114;
+    }
+
+    virtual uint32_t getDefaultVrFrequency() override {
+        return 0;
+    }
+
+    virtual uint8_t init(uint64_t frequency, uint16_t asic_count, uint32_t difficulty, uint32_t vrFrequency) override;
+    virtual int setMaxBaud(void) override;
+    virtual bool setAsicFrequency(float frequency) override;
+    virtual void setJobDifficultyMask(int difficulty) override;
+    virtual void setVrFrequency(uint32_t freq) override;
+
+    virtual uint8_t sendWork(uint32_t job_id, bm_job *next_bm_job) override;
+    virtual bool processWork(task_result *result) override;
+
+    virtual void resetCounter(uint8_t reg) override;
+    virtual void readCounter(uint8_t reg) override;
+};
