+static esp_netif_t *wifi_init_sta(const char *wifi_ssid, const char *wifi_pass)
+{
+    esp_netif_t *esp_netif_sta = esp_netif_create_default_wifi_sta();
+
+    wifi_config_t wifi_sta_config;
+    fill_sta_config(&wifi_sta_config, wifi_ssid, wifi_pass);
 
     ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_STA, &wifi_sta_config));
     return esp_netif_sta;
 }
 
+void wifi_reconfigure_sta(const char *wifi_ssid, const char *wifi_pass)
+{
+    if (!s_inited || !s_netif_sta) {
+        return;
+    }
+
+    wifi_config_t wifi_sta_config;
+    fill_sta_config(&wifi_sta_config, wifi_ssid, wifi_pass);
+
+    s_scan_suppress_reconnect = true;
+    esp_wifi_disconnect();
+    vTaskDelay(pdMS_TO_TICKS(100));
+
+    esp_err_t err = esp_wifi_set_config(WIFI_IF_STA, &wifi_sta_config);
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "esp_wifi_set_config(STA) failed: %s", esp_err_to_name(err));
+    }
+
+    s_retry_num = 0;
+    s_scan_suppress_reconnect = false;
+
+    if (s_has_ssid) {
+        ESP_LOGI(TAG, "Connecting to newly configured WiFi SSID: %s", (const char *)wifi_sta_config.sta.ssid);
+        esp_wifi_connect();
+    }
+}
