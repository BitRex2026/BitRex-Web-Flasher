+#pragma once
+
+#include "asic.h"
+#include "bm1387.h"
+#include "board.h"
+#include "driver/temperature_sensor.h"
+
+class NewPacBoard : public Board {
+protected:
+    bool m_hasEth = false;
+    float m_currentFanSpeed = 1.0f;
+    temperature_sensor_handle_t m_tempSensor = nullptr;
+
+public:
+    NewPacBoard();
+
+    virtual bool initBoard() override;
+    virtual bool initAsics() override;
+
+    virtual bool setVoltage(float core_voltage) override;
+    virtual void setFanSpeedCh(int channel, float perc) override;
+    virtual void getFanSpeedCh(int channel, uint16_t *rpm) override;
+    virtual void setFanPolarity(bool invert) override;
+
+    virtual float getTemperature(int index) override;
+    virtual float getVRTemp() override;
+    virtual float getVRTempInt() override;
+    virtual bool isPIDAvailable() override { return true; }
+
+    virtual float getVin() override;
+    virtual float getIin() override;
+    virtual float getPin() override;
+    virtual float getVout() override;
+    virtual float getIout() override;
+    virtual float getPout() override;
+
+    virtual void requestBuckTelemtry() override;
+    virtual Board::Error getFault(uint32_t *status) override;
+
+    virtual bool hasEthernet() override { return m_hasEth; }
+    virtual const EthPins *getEthPins() override;
+};
