+        ESP_LOGI(TAG_ETH, "ETH link up");
+        onLinkUp();
+        break;
+    case ETHERNET_EVENT_DISCONNECTED:
+        ESP_LOGW(TAG_ETH, "ETH link down");
+        onLinkDown();
+        break;
+    default:
+        break;
+    }
