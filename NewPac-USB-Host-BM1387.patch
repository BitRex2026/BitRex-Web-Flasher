+
+void BM1387::writePllFrequencyUsb(float frequency)
+{
+    if (frequency < 50.0f) {
+        frequency = 50.0f;
+    }
+    if (frequency > 900.0f) {
+        frequency = 900.0f;
+    }
+    float actual = ceilf(100.0f * frequency / 625.0f) * 6.25f;
+
+    uint8_t pll_div = 0x50;
+    uint8_t post_div = 0x41;
+    if (actual < 400.0f) {
+        post_div = 0x41;
+        pll_div  = (uint8_t)(actual * 8.0f / 25.0f);
+    } else if (actual < 600.0f) {
+        post_div = 0x21;
+        pll_div  = (uint8_t)(actual * 4.0f / 25.0f);
+    } else {
+        post_div = 0x11;
+        pll_div  = (uint8_t)(actual * 2.0f / 25.0f);
+    }
+
+    m_actual_current_frequency = actual;
+
+    if (!FTDI_USB_is_connected()) {
+        return;
+    }
+
+    // Broadcast PLL command (works before chain_inactive and on broadcast-enabled chains)
+    uint8_t bcast[9] = {0x58, 0x09, 0x00, 0x0C, 0x00, pll_div, 0x02, post_div, 0x00};
+    bm1387_frame_cmd(bcast, sizeof(bcast));
+    FTDI_USB_write(bcast, sizeof(bcast), 200);
+    vTaskDelay(pdMS_TO_TICKS(5));
+
+    // Per-chip PLL commands for chip 0 (0x00) and chip 1 (0x80) after chain_inactive
+    uint16_t chips = (m_detectedChips > 0) ? m_detectedChips : m_expectedChips;
+    if (chips == 0) {
+        chips = 2;
+    }
+    for (uint16_t i = 0; i < chips; i++) {
+        uint8_t addr = (uint8_t)((0x100u / chips) * i);
+        uint8_t ucast[9] = {0x48, 0x09, addr, 0x0C, 0x00, pll_div, 0x02, post_div, 0x00};
+        bm1387_frame_cmd(ucast, sizeof(ucast));
+        FTDI_USB_write(ucast, sizeof(ucast), 200);
+        vTaskDelay(pdMS_TO_TICKS(5));
+    }
+    ESP_LOGI(TAG, "BM1387 PLL frequency set to %.2f MHz", actual);
+}
+
+bool BM1387::setAsicFrequency(float frequency)
+{
+    if (frequency < 50.0f) {
+        frequency = 50.0f;
+    }
+    if (frequency > 900.0f) {
+        frequency = 900.0f;
+    }
+
+    if (FTDI_USB_is_connected()) {
+        float cur = m_current_frequency;
+        if (cur < 100.0f || cur > 900.0f) {
+            cur = 200.0f;
+        }
+        if (frequency > cur + 25.0f) {
+            while (cur < frequency) {
+                cur += 25.0f;
+                if (cur > frequency) {
+                    cur = frequency;
+                }
+                writePllFrequencyUsb(cur);
+                vTaskDelay(pdMS_TO_TICKS(10));
+            }
+        } else {
+            writePllFrequencyUsb(frequency);
+        }
+    } else {
+        m_actual_current_frequency = ceilf(100.0f * frequency / 625.0f) * 6.25f;
+    }
+
+    m_current_frequency = frequency;
+    return true;
+}
