+#define BM1387_CORES        114
+#define BM1387_MAX_JOB_ID   0x7F
+#define BM1387_RX_LEN       7
+#define BM1387_TASK_LEN     54
+#define BM1387_BAUDDIV_1M5  0x01
+
+// Standard SHA-256 round constants and initial chaining state
+static const uint32_t SHA256_K[64] = {
+    0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u, 0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u,
+    0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u, 0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u,
+    0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu, 0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau,
+    0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u, 0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u,
+    0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u, 0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
+    0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u, 0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u,
+    0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u, 0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u,
+    0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u, 0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u
+};
+
+static const uint32_t SHA256_H0[8] = {
+    0x6a09e667u, 0xbb67ae85u, 0x3c6ef372u, 0xa54ff53au,
+    0x510e527fu, 0x9b05688cu, 0x1f83d9abu, 0x5be0cd19u
+};
+
+static inline uint32_t rotr32(uint32_t x, uint32_t n)
+{
+    return (x >> n) | (x << (32u - n));
+}
+
+// Computes SHA-256 midstate of the first 64 bytes of header80 and writes
+// the reversed little-endian representation (task[20..51]) expected by BM1387.
+static void bm1387_compute_midstate_rev(const uint8_t block[64], uint8_t out_rev[32])
+{
+    uint32_t w[64];
+    for (int i = 0; i < 16; i++) {
+        w[i] = ((uint32_t)block[i * 4 + 0] << 24) |
+               ((uint32_t)block[i * 4 + 1] << 16) |
+               ((uint32_t)block[i * 4 + 2] <<  8) |
+               ((uint32_t)block[i * 4 + 3] <<  0);
+    }
+    for (int i = 16; i < 64; i++) {
+        uint32_t s0 = rotr32(w[i - 15], 7) ^ rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
+        uint32_t s1 = rotr32(w[i - 2], 17) ^ rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
+        w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+    }
+
+    uint32_t a = SHA256_H0[0], b = SHA256_H0[1], c = SHA256_H0[2], d = SHA256_H0[3];
+    uint32_t e = SHA256_H0[4], f = SHA256_H0[5], g = SHA256_H0[6], h = SHA256_H0[7];
+
+    for (int i = 0; i < 64; i++) {
+        uint32_t S1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
+        uint32_t ch = (e & f) ^ (~e & g);
+        uint32_t t1 = h + S1 + ch + SHA256_K[i] + w[i];
+        uint32_t S0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
+        uint32_t maj = (a & b) ^ (a & c) ^ (b & c);
+        uint32_t t2 = S0 + maj;
+
+        h = g;
+        g = f;
+        f = e;
+        e = d + t1;
+        d = c;
+        c = b;
+        b = a;
+        a = t1 + t2;
+    }
+
+    uint32_t st[8] = {
+        SHA256_H0[0] + a, SHA256_H0[1] + b, SHA256_H0[2] + c, SHA256_H0[3] + d,
+        SHA256_H0[4] + e, SHA256_H0[5] + f, SHA256_H0[6] + g, SHA256_H0[7] + h
+    };
+
+    // Pack <8I then reverse 32 bytes == pack st[7]..st[0] big-endian
+    for (int i = 0; i < 8; i++) {
+        uint32_t v = st[7 - i];
+        out_rev[i * 4 + 0] = (uint8_t)((v >> 24) & 0xFF);
+        out_rev[i * 4 + 1] = (uint8_t)((v >> 16) & 0xFF);
+        out_rev[i * 4 + 2] = (uint8_t)((v >>  8) & 0xFF);
+        out_rev[i * 4 + 3] = (uint8_t)((v >>  0) & 0xFF);
+    }
+}
+
+// 5-bit CRC over arbitrary bit length (used for 7-byte RX command responses: 51 bits)
+static uint8_t bm1387_crc5_bits(const uint8_t *data, int bits)
+{
+    uint8_t c[5] = {1, 1, 1, 1, 1};
+    int idx = 0;
+    for (int i = 0; i < bits; i++) {
+        uint8_t c1  = c[1];
+        uint8_t bit = (data[idx] & (0x80 >> (i % 8))) ? 1 : 0;
+        c[1] = c[0];
+        c[0] = c[4] ^ bit;
+        c[4] = c[3];
+        c[3] = c[2];
+        c[2] = c1 ^ c[0];
+        if ((i + 1) % 8 == 0) {
+            idx++;
+        }
+    }
+    return (c[4] << 4) | (c[3] << 3) | (c[2] << 2) | (c[1] << 1) | c[0];
+}
+
+static void bm1387_frame_cmd(uint8_t *buf, size_t len)
+{
+    buf[len - 1] |= bm1387_crc5_bits(buf, (int)(8 * len - 8));
+}
+
+static bool bm1387_is_crc5_ok(const uint8_t rec[BM1387_RX_LEN])
+{
+    return bm1387_crc5_bits(rec, 8 * BM1387_RX_LEN - 5) == (rec[6] & 0x1F);
+}
+
+static bool bm1387_is_cmd_response(const uint8_t rec[BM1387_RX_LEN])
+{
+    return (rec[6] <= 0x1F) && bm1387_is_crc5_ok(rec);
+}
+
+static void bm1387_build_task(const uint8_t header80[80], uint8_t job_id, uint8_t task[BM1387_TASK_LEN])
+{
+    memset(task, 0, BM1387_TASK_LEN);
+    task[0] = 0x21;
+    task[1] = BM1387_TASK_LEN;
+    task[2] = job_id & BM1387_MAX_JOB_ID;
+    task[3] = 0x01; // 1 midstate
+
+    // flip_words(header80[64:76][::-1]): swaps order of the three 4-byte words
+    memcpy(task + 8,  header80 + 72, 4); // nbits / target
+    memcpy(task + 12, header80 + 68, 4); // ntime
+    memcpy(task + 16, header80 + 64, 4); // last 4 bytes of merkle_root
+
+    bm1387_compute_midstate_rev(header80, task + 20);
+
+    uint16_t crc = crc16_false(task, 52);
+    task[52] = (uint8_t)((crc >> 8) & 0xFF);
+    task[53] = (uint8_t)(crc & 0xFF);
+}
+
+static void bm1387_build_ramp_task(uint8_t job_id, uint8_t task[BM1387_TASK_LEN])
+{
+    memset(task, 0, BM1387_TASK_LEN);
+    task[0] = 0x21;
+    task[1] = BM1387_TASK_LEN;
+    task[2] = job_id & BM1387_MAX_JOB_ID;
+    task[3] = 0x01;
+    memset(task + 8, 0xFF, 12);
+
+    uint16_t crc = crc16_false(task, 52);
+    task[52] = (uint8_t)((crc >> 8) & 0xFF);
+    task[53] = (uint8_t)(crc & 0xFF);
+}
+
+BM1387::BM1387() : Asic()
+{
+    m_current_frequency = 150.0f;
+    m_actual_current_frequency = 150.0f;
+    m_asicDifficulty = 1;
+    memset(m_jobHeaders, 0, sizeof(m_jobHeaders));
+    memset(m_jobValid, 0, sizeof(m_jobValid));
+}
+
+bool BM1387::verifyDiff1Nonce(uint8_t job_id, const uint8_t nonce_bytes[4])
+{
+    uint8_t id = job_id & BM1387_MAX_JOB_ID;
+    if (!m_jobValid[id]) {
+        return false;
+    }
+
+    uint8_t header[80];
+    memcpy(header, m_jobHeaders[id], 76);
+    memcpy(header + 76, nonce_bytes, 4);
+
+    uint8_t hash1[32];
+    uint8_t hash2[32];
+    mbedtls_sha256(header, 80, hash1, 0);
+    mbedtls_sha256(hash1,  32, hash2, 0);
+
+    // Difficulty >= 1.0 means top 32 bits of 256-bit LE hash (hash2[28..31]) are zero
+    return (hash2[28] == 0 && hash2[29] == 0 && hash2[30] == 0 && hash2[31] == 0);
+}
